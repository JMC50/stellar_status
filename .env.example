# 서버가 열릴 포트 (필수)
PORT=4101

# 첫 폴링 순환 시작 전 대기 시간(ms) — 브라우저 launch 등 콜드 스타트 완화용 (선택, 기본 5000, 0~120000)
# STELLAR_STATUS_STARTUP_DELAY_MS=5000

# 스트리머가 오프라인→라이브로 전환될 때 stelinfo로 보내는 웹훅 (선택 — 둘 다 없으면 웹훅 비활성화)
# STELINFO_WEBHOOK_URL=http://localhost:3000/webhooks/broadcast-started
# STELINFO_WEBHOOK_SECRET=stelinfo와 동일한 값으로 맞춰야 함
